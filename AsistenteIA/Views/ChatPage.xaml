<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AsistenteIA.ViewModels"
             x:Class="AsistenteIA.Views.ChatPage"
             x:DataType="vm:ChatViewModel"
             Title="Consultar IA"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Carrusel de Plantillas Académicas Predefinidas (RF07) -->
            <Label Text="Plantillas Académicas Rápidas"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"/>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Templates}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AcademicTemplate">
                            <Border Stroke="{StaticResource BorderColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource Surface}"
                                    Padding="12,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=SelectTemplateCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding Icon}" FontSize="16" VerticalOptions="Center"/>
                                    <Label Text="{Binding Title}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Selector de Categoría y Modelo -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Categoría:" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                    <Border Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource Surface}"
                            Padding="8,0">
                        <Picker ItemsSource="{Binding AvailableCategories}"
                                SelectedItem="{Binding SelectedCategory}"
                                TextColor="{StaticResource TextPrimary}"
                                FontSize="13"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Modelo:" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                    <Border Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource Surface}"
                            Padding="8,0">
                        <Label Text="{Binding SelectedModel}"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12"
                               VerticalOptions="Center"
                               HeightRequest="40"
                               VerticalTextAlignment="Center"/>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Tarjeta de Entrada de Prompt (RF01, RF02) -->
            <Border Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource Surface}"
                    Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Pregunta o Instrucción Académica"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{StaticResource TextPrimary}"/>
                        <Label Grid.Column="1"
                               Text="{Binding CharacterCountText}"
                               FontSize="11"
                               TextColor="{StaticResource TextMuted}"/>
                    </Grid>

                    <Editor Text="{Binding Prompt}"
                            Placeholder="Escribe tu consulta académica (mínimo 5 y máximo 2000 caracteres)..."
                            PlaceholderColor="{StaticResource TextMuted}"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="14"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="110"
                            BackgroundColor="Transparent"/>
                </VerticalStackLayout>
            </Border>

            <!-- Botones de Acción (Consultar, Cancelar, Limpiar) (RF03, RF04) -->
            <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="Consultar IA"
                        Command="{Binding AskCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        IsEnabled="{Binding IsNotBusy}"/>

                <Button Grid.Column="1"
                        Text="Cancelar"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{StaticResource Danger}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        IsEnabled="{Binding IsBusy}"/>

                <Button Grid.Column="2"
                        Text="Limpiar"
                        Command="{Binding ClearCommand}"
                        BackgroundColor="{StaticResource Gray300}"
                        TextColor="{StaticResource TextPrimary}"
                        CornerRadius="8"
                        IsEnabled="{Binding IsNotBusy}"/>
            </Grid>

            <!-- Indicador de Carga y Mensaje de Estado (RF04) -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Fill">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"/>
                <Label Text="{Binding StatusMessage}"
                       TextColor="{Binding StatusColor}"
                       FontSize="12"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Tarjeta de Respuesta de la IA -->
            <Border Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource Surface}"
                    Padding="16"
                    IsVisible="{Binding HasAnswer}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="✨" FontSize="16" VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="Respuesta de Gemini"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation"/>
                        </Grid>

                        <Border Grid.Column="1"
                                Stroke="{StaticResource Warning}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="{StaticResource CardBackground}"
                                Padding="6,3"
                                VerticalOptions="Center"
                                HorizontalOptions="End">
                            <Label Text="Verificar fuentes"
                                   FontSize="10"
                                   TextColor="{StaticResource Warning}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}"/>

                    <Label Text="{Binding Answer}"
                           TextColor="{StaticResource TextPrimary}"
                           FontSize="14"
                           LineHeight="1.3"
                           LineBreakMode="WordWrap"/>

                    <!-- Botón para Guardar en Historial SQLite (RF05) -->
                    <Button Text="💾 Guardar en Historial SQLite"
                            Command="{Binding SaveToHistoryCommand}"
                            BackgroundColor="{StaticResource Success}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            IsVisible="{Binding CanSave}"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
