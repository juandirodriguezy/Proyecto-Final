<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AsistenteIA.ViewModels"
             xmlns:m="clr-namespace:AsistenteIA.Models"
             x:Class="AsistenteIA.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="Historial Local"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- Barra de Búsqueda Dinámica (RF06) -->
        <Border Grid.Row="0"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource Surface}"
                Padding="4,0">
            <SearchBar Text="{Binding SearchText}"
                       Placeholder="Buscar en preguntas o respuestas..."
                       PlaceholderColor="{StaticResource TextMuted}"
                       TextColor="{StaticResource TextPrimary}"
                       SearchCommand="{Binding FilterCommand}"
                       CancelButtonColor="{StaticResource Primary}"/>
        </Border>

        <!-- Filtro por Categorías -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Label Grid.Column="0" Text="Categoría:" VerticalOptions="Center" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
            <Border Grid.Column="1"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource Surface}"
                    Padding="10,0">
                <Picker ItemsSource="{Binding FilterCategories}"
                        SelectedItem="{Binding SelectedCategory}"
                        TextColor="{StaticResource TextPrimary}"
                        SelectedIndexChanged="OnCategoryChanged"
                        FontSize="13"/>
            </Border>
        </Grid>

        <!-- Contenedor Principal: Lista y Estados -->
        <Grid Grid.Row="2">
            <!-- Indicador de Carga -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>

            <!-- Estado Vacío -->
            <VerticalStackLayout Spacing="12"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 IsVisible="{Binding HasNoItems}">
                <Label Text="📂" FontSize="48" HorizontalOptions="Center"/>
                <Label Text="No se encontraron consultas"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalOptions="Center"/>
                <Label Text="Realiza una consulta en la sección 'Consultar IA' y guárdala para verla aquí."
                       FontSize="13"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Colección de Consultas Guardadas (RF06 / P07 / P08 / P09) -->
            <CollectionView ItemsSource="{Binding Conversations}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:ConversationRecord">
                        <Border Stroke="{StaticResource BorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource Surface}"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=OpenDetailCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">

                                <!-- Encabezado de la Tarjeta: Categoría y Fecha -->
                                <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <Border BackgroundColor="{StaticResource PrimaryDark}"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,2">
                                        <Label Text="{Binding Category}"
                                               FontSize="11"
                                               TextColor="{StaticResource White}"
                                               FontAttributes="Bold"/>
                                    </Border>
                                    <Label Text="{Binding FormattedDate}"
                                           FontSize="11"
                                           TextColor="{StaticResource TextMuted}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <!-- Botón de Eliminación Rápida -->
                                <Button Grid.Row="0" Grid.Column="1"
                                        Text="🗑️"
                                        FontSize="14"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource Danger}"
                                        HeightRequest="36"
                                        WidthRequest="36"
                                        Padding="0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteConversationCommand}"
                                        CommandParameter="{Binding .}"/>

                                <!-- Prompt de la Consulta -->
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Prompt}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="{StaticResource TextPrimary}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"/>

                                <!-- Extracto de la Respuesta -->
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Answer}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"/>

                                <!-- Estado de Verificación Ética -->
                                <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6" Margin="0,4,0,0">
                                    <!-- Insignia visual de verificación -->
                                    <Border BackgroundColor="{StaticResource CardBackground}"
                                            Stroke="{StaticResource Success}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,2"
                                            IsVisible="{Binding IsVerified}">
                                        <Label Text="✓ Verificada"
                                               FontSize="10"
                                               TextColor="{StaticResource Success}"
                                               FontAttributes="Bold"/>
                                    </Border>

                                    <Border BackgroundColor="{StaticResource CardBackground}"
                                            Stroke="{StaticResource Warning}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,2">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsVerified}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="⚠️ Pendiente de verificar"
                                               FontSize="10"
                                               TextColor="{StaticResource Warning}"/>
                                    </Border>
                                </HorizontalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </Grid>

</ContentPage>
